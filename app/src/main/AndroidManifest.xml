<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
      Pleos 권한은 App Market과 합의한 범위만 선언할 수 있다 (미승인 권한은 심사 탈락).
      도메인별 필요 권한은 Vehicle SDK 2.3.2 클래스의 @RequiresPermission에서 확인했다.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" /> <!-- Wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" /> <!-- Gear, SteeringWheel 각도, Odometer -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" /> <!-- AAOS 표준 차속 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" /> <!-- TBT, 경로·도착 정보 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" /> <!-- 회전 예고 등 녹음이 없는 낭독 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" /> <!-- 선택지 음성 대답 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" /> <!-- 아이 음성 대답(STT) -->

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면이 유지돼야 한다 (뒷좌석 감상용, 조작은 정차 때만 열린다). -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
